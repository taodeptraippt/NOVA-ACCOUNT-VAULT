# NOVA ACCOUNT VAULT — Environment Variables
# Copy this file to .env if you want to override defaults.
# On Pterodactyl panel, you can set these as Startup variables/env instead.

# JWT session secret (change in production!)
SECRET_KEY=nova_vault_super_secret_jwt_key_2026_change_in_production

# Master key for encrypting vault passwords (AES-256-GCM)
CREDENTIAL_ENCRYPTION_KEY=nova_vault_encryption_master_key_2026_fallback

# Optional: override where the SQLite DB is stored (default: ./data/nova_vault.db)
# DATA_DIR=./data
# DATABASE_PATH=

# Optional: override the port the app listens on (default 3000)
# PORT=3000
